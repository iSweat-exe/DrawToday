# Public (safe for the browser): Supabase project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the site (used by robots.txt and sitemap.xml), e.g. https://drawtoday.app
NEXT_PUBLIC_SITE_URL=

# Server only: secret Vercel sends to the keep-alive cron (/api/keep-alive). Any long random string.
CRON_SECRET=
